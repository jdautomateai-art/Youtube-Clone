{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streamhub-youtube-clone",
  "main": "worker/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "YOUTUBE_API_KEY": "AIzaSyCKR9lnAuoju3d4-237GgoClhzNn8sFda0"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
